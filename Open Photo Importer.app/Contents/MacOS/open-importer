#!/bin/bash
set -eu
umask 077

repo="$(dirname "$0")/../../.."
tool="$repo/.github/photo-import"
support="$HOME/Library/Application Support/Constantines Travels Importer"
runtime="${CONSTANTINES_IMPORTER_RUNTIME:-$support/python-3.13}"
url=http://127.0.0.1:8766

alert() {
  /usr/bin/osascript - "$1" <<'APPLESCRIPT'
on run arguments
    display alert "Constantine’s Travels" message (item 1 of arguments)
end run
APPLESCRIPT
}

is_compatible() {
  "$1" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 13) or sys.version_info.releaselevel != "final")'
}

start_importer() (
  set -e
  # Open the files for reading to check actual access, including macOS folder privacy.
  : < "$tool/app.py"
  : < "$tool/requirements.txt"
  cd "$tool"
  if [ -e "$runtime" ] && ! is_compatible "$runtime/bin/python"; then
    mv "$runtime" "$runtime-old-$(date +%s)-$$"
  fi
  if [ ! -x "$runtime/bin/python" ]; then
    "$python" -m venv "$runtime"
  fi
  if ! cmp -s requirements.txt "$runtime/installed-requirements.txt" ||
     ! "$runtime/bin/python" -c 'import PIL, pillow_heif' >/dev/null 2>&1; then
    "$runtime/bin/python" -m pip --isolated install --index-url https://pypi.org/simple --only-binary=:all: --require-hashes -r requirements.txt
    cp requirements.txt "$runtime/installed-requirements.txt"
  fi
  exec "$runtime/bin/python" -B app.py --open "$@"
)

# The development entry point uses the same setup without Finder dialogs.
if [ "${1:-}" = "--development" ]; then
  shift
  python="${CONSTANTINES_IMPORTER_PYTHON:-python3.13}"
  if ! is_compatible "$python"; then
    printf '%s\n' 'Install a stable Python 3.13 release from python.org.'
    exit 1
  fi
  start_importer "$@"
  exit
fi

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
mkdir -p "$support"
running="$(curl --noproxy '*' -fsS --max-time 2 "$url/health" 2>/dev/null || true)"
case "$running" in
  constantines-photo-import-313) exec /usr/bin/open "$url/" ;;
  constantines-photo-import)
    alert "An older importer is still running. Restart your Mac once, then reopen this app. Approved batches are saved."
    exit 1 ;;
esac

# Use an installed Python instead of the macOS developer tools stub.
python=""
for candidate in /Library/Frameworks/Python.framework/Versions/3.13/bin/python3.13 \
  /usr/local/bin/python3.13 /opt/homebrew/bin/python3.13 \
  /opt/homebrew/opt/python@3.13/bin/python3.13 /usr/local/opt/python@3.13/bin/python3.13; do
  if [ -x "$candidate" ] && is_compatible "$candidate"; then
    python="$candidate"
    break
  fi
done
if [ -z "$python" ]; then
  alert "Install a stable Python 3.13 release from python.org, then open Photo Importer again."
  exit 1
fi

log="$support/launcher.log"
# Run as a regular command so Bash still stops setup on the first failure.
set +e
start_importer >"$log" 2>&1
status=$?
set -e
if [ "$status" -ne 0 ]; then
  if grep -Eq 'Operation not permitted|Permission denied' "$log"; then
    alert "macOS denied access while starting the importer. If this checkout is in Documents, move the existing constantines-travels folder to Projects directly inside your home folder, then locate it again in GitHub Desktop. See START HERE in the repository. Your approved batches are saved separately."
  else
    alert "The importer could not start. Check launcher.log in Library → Application Support → Constantines Travels Importer."
  fi
  exit "$status"
fi
