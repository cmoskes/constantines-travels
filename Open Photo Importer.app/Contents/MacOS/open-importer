#!/bin/bash
set -eu
repo="$(cd "$(dirname "$0")/../../.." && pwd)"
support="$HOME/Library/Application Support/Constantines Travels Importer"
umask 077
mkdir -p "$support"
url=http://127.0.0.1:8766
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
alert() {
  /usr/bin/osascript - "$1" <<'APPLESCRIPT'
on run arguments
    display alert "Constantine’s Travels" message (item 1 of arguments)
end run
APPLESCRIPT
}
running="$(curl --noproxy '*' -fsS --max-time 2 "$url/health" 2>/dev/null || true)"
case "$running" in
  constantines-photo-import-313) exec /usr/bin/open "$url/" ;;
  constantines-photo-import)
    alert "An older importer is still running. Restart your Mac once, then reopen this app. Approved batches are saved."
    exit 1 ;;
esac
# The macOS system stub can prompt to install developer tools. Use an installed Python.
python=""
for candidate in /Library/Frameworks/Python.framework/Versions/3.13/bin/python3.13 \
  /usr/local/bin/python3.13 /opt/homebrew/bin/python3.13 \
  /opt/homebrew/opt/python@3.13/bin/python3.13 /usr/local/opt/python@3.13/bin/python3.13; do
  if [ -x "$candidate" ] && "$candidate" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 13) or sys.version_info.releaselevel != "final")'; then
    python="$candidate"
    break
  fi
done
if [ -z "$python" ]; then
  alert "Install a stable Python 3.13 release from python.org, then open Photo Importer again."
  exit 1
fi
export CONSTANTINES_IMPORTER_PYTHON="$python"
if ! "$repo/.github/photo-import/Open Photo Importer.command" >"$support/launcher.log" 2>&1; then
  alert "The importer could not start. Check launcher.log in Library → Application Support → Constantines Travels Importer, or retry after checking your internet connection."
fi
